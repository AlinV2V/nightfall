# ── LLM bots (optional) ──────────────────────────────────────
# Without a key the bots play exactly as they always have, on heuristics.
# With one, they decide night actions, accusations and trial votes through a
# model, and argue in town chat during the day.
#
# Get a key at https://platform.deepseek.com

DEEPSEEK_API_KEY=

# deepseek-v4-flash is fast and cheap and is the right default here.
# deepseek-v4-pro reasons harder and costs about 3x more.
# Note: the old deepseek-chat / deepseek-reasoner names were retired in
# July 2026 and no longer resolve.
NIGHTFALL_LLM_MODEL=deepseek-v4-flash

# Point at an OpenAI-compatible endpoint if you want a different provider or a
# local model. Anything speaking POST /chat/completions will work.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Day-phase table talk costs one call per living bot per day. Set to 0 to keep
# the model for decisions only.
NIGHTFALL_LLM_CHATTER=1
